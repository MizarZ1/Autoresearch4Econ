# 凭证保留在进程环境中；目前不会自动读取 .env。
DEEPSEEK_API_KEY=
ECON_AGENT_MODEL_URL=https://api.deepseek.com
ECON_AGENT_MODEL=deepseek-chat
ECON_AGENT_KEY_VARIABLE=DEEPSEEK_API_KEY
# 同时配置两个 Stata 路径；本机已验证副本见 README，优先使用现有安装。
ECON_AGENT_STATA_HOME=/Applications/Stata
STATA_PATH=/Applications/Stata/StataMP.app/Contents/MacOS/stata-mp
